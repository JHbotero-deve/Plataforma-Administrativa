# --- DATABASE CONFIGURATION ---
DB_HOST=db
DB_PORT=5432
DB_NAME=productos_db
DB_USER=productos_user
DB_PASSWORD=productos_pass

# --- MERCADO LIBRE ---
# Solo necesario si luego vas a acceder a recursos privados de una cuenta.
MELI_CLIENT_ID=tu_client_id_aqui
MELI_CLIENT_SECRET=tu_client_secret_aqui
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=

# --- AMAZON CREATORS API ---
AMAZON_CREDENTIAL_ID=tu_credential_id_aqui
AMAZON_CREDENTIAL_SECRET=tu_credential_secret_aqui
AMAZON_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=tu_partner_tag_aqui
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_CURRENCY=USD

# --- TIKTOK SHOP OPEN API ---
# App Key/Secret de Partner Center y token de una tienda autorizada.
TIKTOK_APP_KEY=tu_app_key_aqui
TIKTOK_APP_SECRET=tu_app_secret_aqui
TIKTOK_ACCESS_TOKEN=tu_access_token_aqui
TIKTOK_SHOP_CIPHER=tu_shop_cipher_aqui

# --- NOTIFICATIONS (TELEGRAM) ---
BOT_TOKEN=tu_bot_token_aqui
CHAT_ID=tu_chat_id_aqui

# --- BUSINESS LOGIC ---
SCORE_THRESHOLD=50
