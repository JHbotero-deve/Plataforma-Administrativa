{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://gracious-renewal-production-76df.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gracious-renewal-production-76df.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/robots.txt",
      "destination": "https://gracious-renewal-production-76df.up.railway.app/api/v1/public/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://gracious-renewal-production-76df.up.railway.app/api/v1/public/sitemap.xml"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/tienda.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tienda",
      "destination": "/tienda.html",
      "permanent": false
    },
    {
      "source": "/catalogo",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/tarjetas",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/producto/:slug",
      "destination": "/producto.html",
      "permanent": false
    }
  ]
}
