# Central / product-analyzer
# Copia este archivo a .env y completa solo las integraciones que uses.

# Base de datos PostgreSQL
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=productos_db
DB_USER=productos_user
DB_PASSWORD=

# API y frontend
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_STORE_URL=https://central-7ykr.vercel.app

# Amazon
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_CREDENTIAL_VERSION=3.1
AMAZON_TRACKING_ID=
AMAZON_BATCH_SIZE=15

# Mercado Libre
MELI_ACCESS_TOKEN=
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REFRESH_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL=3

# TikTok Shop Creator
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_CREATOR_ACCESS_TOKEN=
TIKTOK_CURRENCY=USD

# Wompi - Colombia
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_CURRENCY=COP
WOMPI_ENVIRONMENT=prod
WOMPI_REDIRECT_URL=

# Publicaciones y monetización
MONETIZATION_ADMIN_KEY=
SCORE_THRESHOLD=50
