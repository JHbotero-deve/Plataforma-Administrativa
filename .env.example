# Configuración de Base de Datos PostgreSQL
POSTGRES_DB=gestion_ganadera
POSTGRES_USER=ganadero
POSTGRES_PASSWORD=tu_clave_local_aqui
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Configuración de Seguridad y JWT
JWT_SECRET_KEY=cambiar_por_un_hash_seguro_generado_con_openssl
JWT_EXPIRE_MINUTES=60
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google reCAPTCHA v2 (Backend)
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key
RECAPTCHA_ALLOWED_HOSTNAMES=proyectogestionganadera-production.up.railway.app,localhost,127.0.0.1

# SMTP para recuperación de contraseña
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=jorgebotero190@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail
SMTP_FROM_EMAIL=jorgebotero190@gmail.com
